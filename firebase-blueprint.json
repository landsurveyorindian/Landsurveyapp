{
  "entities": {
    "SurveyProject": {
      "title": "SurveyProject",
      "description": "User land survey project containing calculations, traverse sheets, CAD sketches, or GPS boundary measurements.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string", "maxLength": 150 },
        "state": { "type": "string", "maxLength": 80 },
        "parcelType": { "type": "string", "enum": ["four_sided", "five_sided", "triangle", "traverse", "cad", "gps_walk", "converter"] },
        "areaSqm": { "type": "number" },
        "areaSqFt": { "type": "number" },
        "areaSqYards": { "type": "number" },
        "areaAcres": { "type": "number" },
        "areaCents": { "type": "number" },
        "perimeterMeters": { "type": "number" },
        "notes": { "type": "string", "maxLength": 1000 },
        "summaryJson": { "type": "string", "maxLength": 32768 },
        "createdAt": { "type": "string", "format": "timestamp" },
        "updatedAt": { "type": "string", "format": "timestamp" }
      },
      "required": ["userId", "name", "state", "parcelType", "areaSqm", "createdAt", "updatedAt"]
    },
    "MarketListing": {
      "title": "MarketListing",
      "description": "Land parcel listing on the Sthal Measure marketplace.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "state": { "type": "string", "maxLength": 80 },
        "district": { "type": "string", "maxLength": 100 },
        "surveyNo": { "type": "string", "maxLength": 80 },
        "areaCents": { "type": "number" },
        "areaSqYards": { "type": "number" },
        "areaAcres": { "type": "number" },
        "priceInr": { "type": "number" },
        "sellerName": { "type": "string", "maxLength": 100 },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "boundaryGeoJson": { "type": "string", "maxLength": 32768 },
        "photoUri": { "type": "string", "maxLength": 500 },
        "verified": { "type": "boolean" },
        "verificationStatus": { "type": "string", "enum": ["unverified", "pending", "verified", "rejected"] },
        "createdAt": { "type": "string", "format": "timestamp" },
        "updatedAt": { "type": "string", "format": "timestamp" }
      },
      "required": ["userId", "title", "state", "areaCents", "priceInr", "verified", "verificationStatus", "createdAt", "updatedAt"]
    },
    "PrivateSellerData": {
      "title": "PrivateSellerData",
      "description": "Private seller phone and email restricted to the listing owner and Super Admin Owner.",
      "type": "object",
      "properties": {
        "listingId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string" },
        "sellerName": { "type": "string", "maxLength": 100 },
        "sellerEmail": { "type": "string", "maxLength": 160 },
        "sellerPhone": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string", "format": "timestamp" },
        "updatedAt": { "type": "string", "format": "timestamp" }
      },
      "required": ["listingId", "userId", "sellerPhone", "createdAt", "updatedAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated surveyor user profile with role and preferred Indian state.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "maxLength": 160 },
        "displayName": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "enum": ["owner", "developer", "user"] },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "photoUrl": { "type": "string", "maxLength": 500 },
        "preferredState": { "type": "string", "maxLength": 80 },
        "createdAt": { "type": "string", "format": "timestamp" },
        "updatedAt": { "type": "string", "format": "timestamp" }
      },
      "required": ["uid", "email", "role", "status", "createdAt", "updatedAt"]
    },
    "DeveloperEmail": {
      "title": "DeveloperEmail",
      "description": "Owner-managed allowlist mapping verified email IDs to Developer Dashboard access.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 160 },
        "label": { "type": "string", "maxLength": 100 },
        "active": { "type": "boolean" },
        "addedByUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "timestamp" },
        "updatedAt": { "type": "string", "format": "timestamp" }
      },
      "required": ["email", "label", "active", "addedByUid", "createdAt", "updatedAt"]
    },
    "BugReport": {
      "title": "BugReport",
      "description": "User bug report triaged by developers and owner.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string", "maxLength": 160 },
        "userName": { "type": "string", "maxLength": 120 },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "module": { "type": "string", "maxLength": 80 },
        "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "status": { "type": "string", "enum": ["new", "investigating", "resolved", "closed"] },
        "appVersion": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string", "format": "timestamp" },
        "updatedAt": { "type": "string", "format": "timestamp" }
      },
      "required": ["userId", "title", "description", "module", "severity", "status", "createdAt", "updatedAt"]
    },
    "SystemSetting": {
      "title": "SystemSetting",
      "description": "Owner-controlled global kill switches, per-group permission maps, maintenance banner, and announcements.",
      "type": "object",
      "properties": {
        "announcementTitle": { "type": "string", "maxLength": 200 },
        "announcementMessage": { "type": "string", "maxLength": 1000 },
        "maintenanceMode": { "type": "boolean" },
        "calculatorEnabled": { "type": "boolean" },
        "cadStudioEnabled": { "type": "boolean" },
        "gpsWalkEnabled": { "type": "boolean" },
        "gisImportExportEnabled": { "type": "boolean" },
        "pdfReportsEnabled": { "type": "boolean" },
        "marketplaceEnabled": { "type": "boolean" },
        "aiAdvisorEnabled": { "type": "boolean" },
        "documentScannerEnabled": { "type": "boolean" },
        "academyEnabled": { "type": "boolean" },
        "userGroupPermissions": { "type": "object" },
        "developerGroupPermissions": { "type": "object" },
        "updatedAt": { "type": "string", "format": "timestamp" }
      },
      "required": [
        "announcementTitle",
        "announcementMessage",
        "maintenanceMode",
        "calculatorEnabled",
        "cadStudioEnabled",
        "gpsWalkEnabled",
        "gisImportExportEnabled",
        "marketplaceEnabled",
        "aiAdvisorEnabled",
        "documentScannerEnabled",
        "academyEnabled",
        "updatedAt"
      ]
    },
    "UserFeaturePermissions": {
      "title": "UserFeaturePermissions",
      "description": "Per-account feature permission map keyed by Firebase Auth uid.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "maxLength": 160 },
        "username": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "enum": ["owner", "developer", "user"] },
        "permissions": { "type": "object" },
        "createdAt": { "type": "string", "format": "timestamp" },
        "updatedAt": { "type": "string", "format": "timestamp" },
        "updatedBy": { "type": "string" },
        "version": { "type": "integer" }
      },
      "required": ["uid", "email", "role", "permissions", "createdAt", "updatedAt", "updatedBy", "version"]
    },
    "PermissionAuditLog": {
      "title": "PermissionAuditLog",
      "description": "Immutable history of Owner feature permission edits per account.",
      "type": "object",
      "properties": {
        "targetUid": { "type": "string" },
        "targetEmail": { "type": "string" },
        "action": { "type": "string", "enum": ["create", "update", "restore_defaults"] },
        "changesSummary": { "type": "string" },
        "updatedBy": { "type": "string" },
        "updatedByEmail": { "type": "string" },
        "createdAt": { "type": "string", "format": "timestamp" }
      },
      "required": ["targetUid", "action", "updatedBy", "createdAt"]
    },
    "AcademyVideoEntry": {
      "title": "AcademyVideoEntry",
      "description": "Owner-managed episode metadata and video stream URLs.",
      "type": "object",
      "properties": {
        "episodeNumber": { "type": "integer" },
        "title": { "type": "string" },
        "difficulty": { "type": "string", "enum": ["Beginner", "Intermediate", "Advanced"] },
        "videoUrl": { "type": "string" },
        "updatedBy": { "type": "string" },
        "updatedAt": { "type": "string", "format": "timestamp" }
      },
      "required": ["episodeNumber", "title", "difficulty", "videoUrl", "updatedBy", "updatedAt"]
    },
    "ListingReport": {
      "title": "ListingReport",
      "description": "Marketplace listing abuse/inaccuracy report.",
      "type": "object",
      "properties": {
        "listingId": { "type": "string" },
        "listingTitle": { "type": "string" },
        "reporterUid": { "type": "string" },
        "reporterEmail": { "type": "string" },
        "reason": { "type": "string" },
        "details": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "reviewed", "dismissed"] },
        "createdAt": { "type": "string", "format": "timestamp" },
        "updatedAt": { "type": "string", "format": "timestamp" }
      },
      "required": ["listingId", "reporterUid", "reason", "status", "createdAt", "updatedAt"]
    },
    "MarketInquiry": {
      "title": "MarketInquiry",
      "description": "Buyer-to-seller contact inquiry without exposing private seller phone/email.",
      "type": "object",
      "properties": {
        "listingId": { "type": "string" },
        "listingTitle": { "type": "string" },
        "sellerUid": { "type": "string" },
        "buyerUid": { "type": "string" },
        "buyerName": { "type": "string" },
        "buyerPhone": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["sent", "acknowledged"] },
        "createdAt": { "type": "string", "format": "timestamp" },
        "updatedAt": { "type": "string", "format": "timestamp" }
      },
      "required": ["listingId", "sellerUid", "buyerUid", "buyerName", "buyerPhone", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/survey_projects/{projectId}": {
      "schema": "SurveyProject",
      "description": "Private survey projects accessible strictly to owner userId (and Super Admin Owner)."
    },
    "/market_listings/{listingId}": {
      "schema": "MarketListing",
      "description": "Publicly readable non-PII land listings; owners cannot self-verify."
    },
    "/market_seller_data/{listingId}": {
      "schema": "PrivateSellerData",
      "description": "Private seller phone and email restricted to owner userId and Super Admin Owner."
    },
    "/listing_reports/{reportId}": {
      "schema": "ListingReport",
      "description": "Marketplace moderation flags readable by reporter, developer, and owner."
    },
    "/market_inquiries/{inquiryId}": {
      "schema": "MarketInquiry",
      "description": "Safe buyer inquiries visible to buyer, listing owner, and Super Admin Owner."
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Surveyor user profiles with role protection."
    },
    "/developer_emails/{emailId}": {
      "schema": "DeveloperEmail",
      "description": "Owner-managed developer email allowlist recognizing authorized developer email IDs."
    },
    "/system_settings/{settingId}": {
      "schema": "SystemSetting",
      "description": "Global feature controls, role-group flags, and announcements writable only by Owner."
    },
    "/userFeaturePermissions/{userId}": {
      "schema": "UserFeaturePermissions",
      "description": "Individual per-user feature permissions managed exclusively by Owner."
    },
    "/permissionAuditLogs/{logId}": {
      "schema": "PermissionAuditLog",
      "description": "Immutable permission change log writable and readable only by Owner."
    },
    "/academy_videos/{videoId}": {
      "schema": "AcademyVideoEntry",
      "description": "Academy episode stream configuration managed by Owner."
    },
    "/bug_reports/{reportId}": {
      "schema": "BugReport",
      "description": "User-submitted bug reports accessible to creator and triage staff."
    }
  }
}
